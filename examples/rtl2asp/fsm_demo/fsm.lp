% ---- CLOCK / HORIZON  (supplied by the run: #const k. + time(clk,0..k).) ----
% design references time(clk, T) and the bound T < k
% CLOCKS (the design's full clock structure):
%   clk  -- free (drive time(clk, 0..k) in the scenario)

% ---- COMBINATIONAL (Group 1)  [style=v1] ----
% fsm.sv:11  assign busy = (state != IDLE);
val(busy, 1, T) :- val(state, S, T), S != idle.
val(busy, 0, T) :- val(state, idle, T).

% ---- SEQUENTIAL (Group 2) ----
% fsm.sv:5  [reg state]  if (rst) state <= IDLE;
val(state, idle, T+1) :- time(clk, T), T < k, val(rst, 1, T).
% fsm.sv:7  IDLE:   if (go)   state <= RUN;
val(state, run, T+1) :- time(clk, T), T < k, val(state, idle, T), val(rst, 0, T), val(go, 1, T).
% fsm.sv:7  IDLE:   if (go)   state <= RUN;
val(state, V0, T+1) :- time(clk, T), T < k, val(state, idle, T), val(rst, 0, T), val(go, 0, T), val(state, V0, T).
% fsm.sv:8  RUN:    if (done) state <= FINISH;
val(state, finish, T+1) :- time(clk, T), T < k, val(state, run, T), val(rst, 0, T), val(done, 1, T).
% fsm.sv:8  RUN:    if (done) state <= FINISH;
val(state, V0, T+1) :- time(clk, T), T < k, val(state, run, T), val(rst, 0, T), val(done, 0, T), val(state, V0, T).
% fsm.sv:9  FINISH:           state <= IDLE;
val(state, idle, T+1) :- time(clk, T), T < k, val(state, finish, T), val(rst, 0, T).
val(state, V0, T+1) :- time(clk, T), T < k, val(state, V1, T), V1 != finish, V1 != idle, V1 != run, val(rst, 0, T), val(state, V0, T).

