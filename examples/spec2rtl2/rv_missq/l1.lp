% GENERATED by generate.py (depth 4, demandReserve 1, maxOutstandingFetches 2) -- do not edit by hand.
% The instruction-fetch miss queue. An ENTRY IS A LINE: a demand meeting a
% prefetched line LIFTS that entry rather than taking a slot of its own.
module(rvMissq).

% the parameters: the print carries these as `#(parameter ...)`; the certificate
% runs at the defaults, which are the signature's -- the proven configuration
param(depth, 4).
param(demandReserve, 1).
param(maxOutstandingFetches, 2).
param(addressWidth, 26).
param(dataWidth, 128).
param(tagWidth, 4).
% countWidth is DERIVED, never independently overridable: an instantiation that
% raised DEPTH and forgot the width would cast DEPTH to fewer bits than it
% needs and every threshold would collapse (the user's review, 2026-08-31)
param(countWidth, log2(add(depth, 1))).
param(top, sub(depth, 1)).

port(clk, input, 1). port(resetN, input, 1).
port(requestValid, input, 1). port(requestReady, output, 1).
port(requestAddress, input, addressWidth). port(requestTag, input, tagWidth).
port(requestIsDemand, input, 1).
port(redirectValid, input, 1).
port(fetchStall, output, 1).
port(memoryRequestValid, output, 1). port(memoryRequestReady, input, 1).
port(memoryRequestAddress, output, addressWidth).
port(fillValid, input, 1). port(fillAddress, input, addressWidth).
port(fillData, input, dataWidth).
port(forwardValid, output, 1). port(forwardTag, output, tagWidth).
port(forwardData, output, dataWidth).

% the opaque payloads: tokens, compared and routed, never enumerated
data(requestAddress). data(requestTag). data(fillAddress). data(fillData).
data(memoryRequestAddress). data(forwardTag). data(forwardData).

% the state lanes, DECLARED up front: their logic and flops live in the STATE
% section below, but the CAM and the policy read them
net_lane(valid, depth, 1). net_lane(dem, depth, 1). net_lane(want, depth, 1).
net_lane(infl, depth, 1). net_lane(fill, depth, 1).
net_lane(addr, depth, addressWidth). net_lane(entryTag, depth, tagWidth).
net_lane(line, depth, dataWidth). net_lane(ptrHot, depth, 1).
net_lane(askPtrHot, depth, 1).

% ---- CAM: equality, and nothing else -----------------------------------------
net_lane(joinable, depth, 1).
def_lane(joinable, I, logand(valid(I), logor(want(I), infl(I)))).
net_lane(free, depth, 1).
def_lane(free, I, lnot(valid(I))).
net_lane(amatch, depth, 1).
def_lane(amatch, I, logand(joinable(I), eq(addr(I), requestAddress))).
net_lane(fillhit, depth, 1).
def_lane(fillhit, I, logand(logand(fillValid, valid(I)), logand(infl(I), eq(addr(I), fillAddress)))).

% ---- POLICY: what an equality MEANS. Every race is decided here. --------------
% someMatchUpTo: a joinable entry holds the request's line
net_lane(someMatchUpTo, depth, 1).
def(someMatchUpTo(0), amatch(0)).
def_lane(someMatchUpTo, I, logor(someMatchUpTo(I-1), amatch(I))).
net(someMatch, 1). def(someMatch, someMatchUpTo(top)).
% demMatchUpTo: that joinable entry is already demanding
net_lane(demMatchUpTo, depth, 1).
def(demMatchUpTo(0), logand(amatch(0), dem(0))).
def_lane(demMatchUpTo, I, logor(demMatchUpTo(I-1), logand(amatch(I), dem(I)))).
net(matchDem, 1). def(matchDem, demMatchUpTo(top)).
net(isPrefetch, 1). def(isPrefetch, lnot(requestIsDemand)).
% the fetch pipe is stalled by a second demand for a line already demanded: an
% entry holds ONE demand entryTag, so the second cannot merge and must wait
net(repeatDemand, 1). def(repeatDemand, logand(logand(requestValid, requestIsDemand), matchDem)).
def(fetchStall, repeatDemand).

% the two counts: popcount chains, combinational (see the module header)
net_lane(liveCnt, depth, countWidth).
def(liveCnt(0), add(k(0, countWidth), valid(0), countWidth)).
def_lane(liveCnt, I, add(liveCnt(I-1), valid(I), countWidth)).
net(liveCount, countWidth). def(liveCount, liveCnt(top)).
net_lane(inflCnt, depth, countWidth).
% the count is of EXISTING entries in flight: valid-gated, exactly as the
% inFlight window is -- a stale infl bit in an invalid slot is not an entry
% (the user's reset review, 2026-08-31)
net_lane(inflLive, depth, 1).
def_lane(inflLive, I, logand(valid(I), infl(I))).
def(inflCnt(0), add(k(0, countWidth), inflLive(0), countWidth)).
def_lane(inflCnt, I, add(inflCnt(I-1), inflLive(I), countWidth)).
net(inflCount, countWidth). def(inflCount, inflCnt(top)).
% the three thresholds are PARAMETER EXPRESSIONS, never baked numbers -- a
% parameterized module whose compares hard-code the defaults is parameterized
% in name only (the user's review, 2026-08-31)
net(roomForDemand, 1). def(roomForDemand, lt(liveCount, k(depth, countWidth), countWidth)).
net(roomForPrefetch, 1). def(roomForPrefetch, lt(liveCount, k(sub(depth, demandReserve), countWidth), countWidth)).
net(fetchLimitAllows, 1). def(fetchLimitAllows, lt(inflCount, k(maxOutstandingFetches, countWidth), countWidth)).

% ACCEPTANCE, decided in exactly one place. A demand may take the reserve; a
% prefetch may not; a repeat demand is never taken. A request that JOINS a line
% already here needs no room at all -- merging and lifting consume no slot.
net(noRoomNeeded, 1). def(noRoomNeeded, someMatch).
net(demandOk, 1). def(demandOk, logand(logand(requestIsDemand, logor(noRoomNeeded, roomForDemand)), lnot(repeatDemand))).
net(prefetchOk, 1). def(prefetchOk, logand(isPrefetch, logor(noRoomNeeded, roomForPrefetch))).
def(requestReady, logand(requestValid, logor(demandOk, prefetchOk))).
net(accepted, 1). def(accepted, logand(requestValid, requestReady)).
net(allocating, 1). def(allocating, logand(accepted, lnot(someMatch))).

% seenFree: has any slot at or below I got free?
net_lane(seenFree, depth, 1).
def(seenFree(0), free(0)).
def_lane(seenFree, I, logor(seenFree(I-1), free(I))).
% allocation takes the lowest free slot; a LIFT takes no slot at all
net_lane(firstFree, depth, 1).
def(firstFree(0), free(0)).
def_lane(firstFree, I, logand(free(I), lnot(seenFree(I-1)))).

net_lane(alloc, depth, 1).
def_lane(alloc, I, logand(allocating, firstFree(I))).
net_lane(lift, depth, 1).
def_lane(lift, I, logand(logand(accepted, requestIsDemand), logand(amatch(I), lnot(dem(I))))).

% the enquiry: a demanding entry is served before any prefetching one
% demWaitUpTo: some demanding entry still wants its fetch
net_lane(demWaitUpTo, depth, 1).
def(demWaitUpTo(0), logand(valid(0), logand(want(0), dem(0)))).
def_lane(demWaitUpTo, I, logor(demWaitUpTo(I-1), logand(valid(I), logand(want(I), dem(I))))).
net(demWaiting, 1). def(demWaiting, demWaitUpTo(top)).
net_lane(eligible, depth, 1).
def_lane(eligible, I, logand(logand(valid(I), want(I)), logor(dem(I), lnot(demWaiting)))).
% eligUpTo: is any slot eligible at all?
net_lane(eligUpTo, depth, 1).
def(eligUpTo(0), eligible(0)).
def_lane(eligUpTo, I, logor(eligUpTo(I-1), eligible(I))).
net(enquiryTaken, 1). def(enquiryTaken, logand(memoryRequestValid, memoryRequestReady)).

% ---- the enquiry: rotation on the fetch side too. `choose fairly among eligible
% entries` is the askMemory behaviour's stated obligation, and fixed lowest-index
% priority starves a high slot exactly as it would on the forward side (the
% user's review caught the asymmetry, 2026-08-31)
net_lane(askPtrHotM1, depth, 1).
net_lane(hotAskPtrHotUpTo, depth, 1).
def(hotAskPtrHotUpTo(0), askPtrHot(0)).
def_lane(hotAskPtrHotUpTo, I, logor(hotAskPtrHotUpTo(I-1), askPtrHot(I))).
net(noneAskPtrHot, 1). def(noneAskPtrHot, lnot(hotAskPtrHotUpTo(top))).
net_lane(thermoAskPtrHot, depth, 1).
def(thermoAskPtrHot(0), logor(askPtrHot(0), noneAskPtrHot)).
def_lane(thermoAskPtrHot, I, logor(thermoAskPtrHot(I-1), askPtrHot(I))).
% the first eligible slot AT or AFTER the pointer wins ...
net_lane(askLow, depth, 1).
def_lane(askLow, I, logand(eligible(I), thermoAskPtrHot(I))).
% askSeenLow: has any slot at or below I got askLow?
net_lane(askSeenLow, depth, 1).
def(askSeenLow(0), askLow(0)).
def_lane(askSeenLow, I, logor(askSeenLow(I-1), askLow(I))).
% askLowWin: the winner in the at-or-after half
net_lane(askLowWin, depth, 1).
def(askLowWin(0), askLow(0)).
def_lane(askLowWin, I, logand(askLow(I), lnot(askSeenLow(I-1)))).

net(askAnyLow, 1). def(askAnyLow, askSeenLow(top)).
% ... else the first eligible slot BEFORE it (the wrap half)
net_lane(askHigh, depth, 1).
def_lane(askHigh, I, logand(eligible(I), lnot(thermoAskPtrHot(I)))).
% askSeenHigh: has any slot at or below I got askHigh?
net_lane(askSeenHigh, depth, 1).
def(askSeenHigh(0), askHigh(0)).
def_lane(askSeenHigh, I, logor(askSeenHigh(I-1), askHigh(I))).
% askHighWin: the wrap half's candidate, taken only when the low half is empty
net_lane(askHighWin, depth, 1).
def(askHighWin(0), askHigh(0)).
def_lane(askHighWin, I, logand(askHigh(I), lnot(askSeenHigh(I-1)))).

net_lane(ask, depth, 1).
def_lane(ask, I, logor(askLowWin(I), logand(askHighWin(I), lnot(askAnyLow)))).
% the pointer: to the slot after the grant when enquiryTaken fires, else hold;
% the ring closes through the boundary member
def(askPtrHotM1(0), ite(enquiryTaken, ask(top), askPtrHot(0))).
def_lane(askPtrHotM1, I, ite(enquiryTaken, ask(I-1), askPtrHot(I))).
inst_lane(uAskPtrHot, arff, depth).
pin(uAskPtrHot, clk, clk). pin(uAskPtrHot, rstL, resetN). pin(uAskPtrHot, en, one).
pin(uAskPtrHot, d, askPtrHotM1). pin(uAskPtrHot, q, askPtrHot).
iparam(uAskPtrHot, width, 1). iparam(uAskPtrHot, reset_value, 0).

def(memoryRequestValid, logand(eligUpTo(top), fetchLimitAllows)).
% the enquiry's address: a selection chain over the asking slot
net_lane(askAddr, depth, addressWidth).
def(askAddr(0), addr(0)).
def_lane(askAddr, I, ite(ask(I), addr(I), askAddr(I-1))).
def(memoryRequestAddress, askAddr(top)).
net_lane(taken, depth, 1).
def_lane(taken, I, logand(logand(memoryRequestValid, memoryRequestReady), ask(I))).

% ---- THE ANSWER: one filled demanding entry forwarded per cycle, in ROTATION.
% Fixed priority starves a high slot at depths above four; a rotating pointer
% bounds any slot's wait at `depth` grants, at EVERY depth -- the parametric fact
% is RouteLean.Rotation.reaches. The pointer is ONE-HOT; `thermo` is the
% thermometer 'the pointer sits at or below I', whose lane-0 boundary also
% absorbs the all-zeros power-on (read as: pointer at slot 0).
net_lane(ripe, depth, 1).
def_lane(ripe, I, logand(valid(I), logand(fill(I), dem(I)))).
% anyRipeUpTo: is anything ready to forward?
net_lane(anyRipeUpTo, depth, 1).
def(anyRipeUpTo(0), ripe(0)).
def_lane(anyRipeUpTo, I, logor(anyRipeUpTo(I-1), ripe(I))).
def(forwardValid, anyRipeUpTo(top)).

% ---- the answer: one filled demanding entry forwarded per cycle, in rotation.
% Fixed priority starves a high slot at depths above four; the rotating
% pointer bounds any slot's wait at depth grants, at EVERY depth
% (RouteLean.Rotation.reaches)
net_lane(ptrHotM1, depth, 1).
net_lane(hotPtrHotUpTo, depth, 1).
def(hotPtrHotUpTo(0), ptrHot(0)).
def_lane(hotPtrHotUpTo, I, logor(hotPtrHotUpTo(I-1), ptrHot(I))).
net(nonePtrHot, 1). def(nonePtrHot, lnot(hotPtrHotUpTo(top))).
net_lane(thermoPtrHot, depth, 1).
def(thermoPtrHot(0), logor(ptrHot(0), nonePtrHot)).
def_lane(thermoPtrHot, I, logor(thermoPtrHot(I-1), ptrHot(I))).
% the first ripe slot AT or AFTER the pointer wins ...
net_lane(fwdLow, depth, 1).
def_lane(fwdLow, I, logand(ripe(I), thermoPtrHot(I))).
% fwdSeenLow: has any slot at or below I got fwdLow?
net_lane(fwdSeenLow, depth, 1).
def(fwdSeenLow(0), fwdLow(0)).
def_lane(fwdSeenLow, I, logor(fwdSeenLow(I-1), fwdLow(I))).
% fwdLowWin: the winner in the at-or-after half
net_lane(fwdLowWin, depth, 1).
def(fwdLowWin(0), fwdLow(0)).
def_lane(fwdLowWin, I, logand(fwdLow(I), lnot(fwdSeenLow(I-1)))).

net(fwdAnyLow, 1). def(fwdAnyLow, fwdSeenLow(top)).
% ... else the first ripe slot BEFORE it (the wrap half)
net_lane(fwdHigh, depth, 1).
def_lane(fwdHigh, I, logand(ripe(I), lnot(thermoPtrHot(I)))).
% fwdSeenHigh: has any slot at or below I got fwdHigh?
net_lane(fwdSeenHigh, depth, 1).
def(fwdSeenHigh(0), fwdHigh(0)).
def_lane(fwdSeenHigh, I, logor(fwdSeenHigh(I-1), fwdHigh(I))).
% fwdHighWin: the wrap half's candidate, taken only when the low half is empty
net_lane(fwdHighWin, depth, 1).
def(fwdHighWin(0), fwdHigh(0)).
def_lane(fwdHighWin, I, logand(fwdHigh(I), lnot(fwdSeenHigh(I-1)))).

net_lane(fwd, depth, 1).
def_lane(fwd, I, logor(fwdLowWin(I), logand(fwdHighWin(I), lnot(fwdAnyLow)))).
% the pointer: to the slot after the grant when forwardValid fires, else hold;
% the ring closes through the boundary member
def(ptrHotM1(0), ite(forwardValid, fwd(top), ptrHot(0))).
def_lane(ptrHotM1, I, ite(forwardValid, fwd(I-1), ptrHot(I))).
inst_lane(uPtrHot, arff, depth).
pin(uPtrHot, clk, clk). pin(uPtrHot, rstL, resetN). pin(uPtrHot, en, one).
pin(uPtrHot, d, ptrHotM1). pin(uPtrHot, q, ptrHot).
iparam(uPtrHot, width, 1). iparam(uPtrHot, reset_value, 0).

% the granted slot's payload, by a selection chain
net_lane(fwdTagSel, depth, tagWidth).
def(fwdTagSel(0), entryTag(0)).
def_lane(fwdTagSel, I, ite(fwd(I), entryTag(I), fwdTagSel(I-1))).
def(forwardTag, fwdTagSel(top)).
net_lane(fwdDataSel, depth, dataWidth).
def(fwdDataSel(0), line(0)).
def_lane(fwdDataSel, I, ite(fwd(I), line(I), fwdDataSel(I-1))).
def(forwardData, fwdDataSel(top)).

% an entry ends when it is answered, or when a prefetched line has landed
net_lane(ends, depth, 1).
def_lane(ends, I, logand(valid(I), logor(logand(forwardValid, fwd(I)), logand(fill(I), lnot(dem(I)))))).

% ---- STATE: the slots. Every register xx is fed by xxM1, its complete next
% value with the hold term VISIBLE, and the flop is xx <= xxM1. --------------

% valid: set on allocation, cleared on ending, else hold. The one reset register
% per slot -- a slot whose valid is 0 makes every other field invisible.
net_lane(validM1, depth, 1).
def_lane(validM1, I, logor(alloc(I), logand(valid(I), lnot(ends(I))))).
inst_lane(uValid, arff, depth).
pin(uValid, clk, clk). pin(uValid, rstL, resetN). pin(uValid, en, one).
pin(uValid, d, validM1). pin(uValid, q, valid).
iparam(uValid, width, 1). iparam(uValid, reset_value, 0).
net(one, 1). def(one, k(1, 1)).

% demanding: set by a demand allocation or a lift, cleared by redirect or ending
net_lane(demM1, depth, 1).
def_lane(demM1, I, logor(logor(logand(alloc(I), requestIsDemand), lift(I)), logand(dem(I), lnot(logor(alloc(I), logor(redirectValid, ends(I))))))).
inst_lane(uDem, ff, depth).
pin(uDem, clk, clk). pin(uDem, en, one). pin(uDem, d, demM1). pin(uDem, q, dem).
iparam(uDem, width, 1).

% wantsFetch: set on allocation, cleared when the enquiry is taken or on ending
net_lane(wantM1, depth, 1).
def_lane(wantM1, I, logor(alloc(I), logand(want(I), lnot(logor(taken(I), ends(I)))))).
inst_lane(uWant, ff, depth).
pin(uWant, clk, clk). pin(uWant, en, one). pin(uWant, d, wantM1). pin(uWant, q, want).
iparam(uWant, width, 1).

% inFlight: set when the enquiry is taken, cleared by the fill, ending, or a
% fresh allocation of the slot
net_lane(inflM1, depth, 1).
def_lane(inflM1, I, logor(taken(I), logand(infl(I), lnot(logor(fillhit(I), logor(ends(I), alloc(I))))))).
inst_lane(uInfl, ff, depth).
pin(uInfl, clk, clk). pin(uInfl, en, one). pin(uInfl, d, inflM1). pin(uInfl, q, infl).
iparam(uInfl, width, 1).

% filled: set by the fill, cleared by ending or a fresh allocation
net_lane(fillM1, depth, 1).
def_lane(fillM1, I, logor(fillhit(I), logand(fill(I), lnot(logor(ends(I), alloc(I)))))).
inst_lane(uFill, ff, depth).
pin(uFill, clk, clk). pin(uFill, en, one). pin(uFill, d, fillM1). pin(uFill, q, fill).
iparam(uFill, width, 1).

% the payloads. The address never changes while the entry lives -- an entry IS a
% line. The entryTag follows a lift: the new demand's entryTag replaces the prefetch's.
net_lane(addrM1, depth, addressWidth).
def_lane(addrM1, I, ite(alloc(I), requestAddress, addr(I))).
inst_lane(uAddr, ff, depth).
pin(uAddr, clk, clk). pin(uAddr, en, one). pin(uAddr, d, addrM1). pin(uAddr, q, addr).
iparam(uAddr, width, addressWidth).

net_lane(entryTagM1, depth, tagWidth).
def_lane(entryTagM1, I, ite(logor(alloc(I), lift(I)), requestTag, entryTag(I))).
inst_lane(uEntryTag, ff, depth).
pin(uEntryTag, clk, clk). pin(uEntryTag, en, one). pin(uEntryTag, d, entryTagM1). pin(uEntryTag, q, entryTag).
iparam(uEntryTag, width, tagWidth).

net_lane(lineM1, depth, dataWidth).
def_lane(lineM1, I, ite(fillhit(I), fillData, line(I))).
inst_lane(uLine, ff, depth).
pin(uLine, clk, clk). pin(uLine, en, one). pin(uLine, d, lineM1). pin(uLine, q, line).
iparam(uLine, width, dataWidth).


% the slot payload lanes and everything that routes them are token nets too;
% data() on a lane declares every member. Declared LAST: a lane must exist
% before it can be called data.
data(addr). data(entryTag). data(line).
data(addrM1). data(entryTagM1). data(lineM1).
data(askAddr). data(fwdTagSel). data(fwdDataSel).

